# =============================================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored and never committed. Only edit `.env.example` when
# adding a new variable that every developer should know about.
# =============================================================================

# --- Supabase (cloud dev project) — read by the Vite app at runtime ----------
# Get these from your Supabase dashboard:
#   https://supabase.com/dashboard/project/<your-ref>/settings/api
#
# Use the DEV project for development. The PROD project's keys live only in
# Vercel's env vars — never on a laptop.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase CLI (used by `pnpm supabase:*` scripts) ------------------------
# Project ref is the short slug in your Supabase URL ("your-project-ref" above).
# Needed to run `supabase link`, `db push`, `gen types`, etc.
SUPABASE_PROJECT_REF=your-project-ref

# Personal access token from https://supabase.com/dashboard/account/tokens
# Only LEADS need this — newcomers don't run db push or gen types.
# In Codespaces, prefer setting this as a "Codespaces secret" on GitHub
# (Settings → Codespaces → New secret) instead of putting it in .env.
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx
