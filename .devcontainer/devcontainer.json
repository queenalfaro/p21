{
    "name": "Event App",

    "dockerComposeFile": ["../docker-compose.yml"],
    "service": "app",
    "workspaceFolder": "/workspace",
    "remoteUser": "node",

    "forwardPorts": [5173],

    "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",

    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },

    "mounts": [
        "source=\\\\wsl.localhost\\Ubuntu\\home\\user\\.claude,target=/home/node/.claude,type=bind,consistency=cached",
        "source=\\\\wsl.localhost\\Ubuntu\\home\\user\\.claude.json,target=/home/node/.claude.json,type=bind,consistency=cached"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                // Lint / format / editor hygiene
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "EditorConfig.EditorConfig",

                // React / Tailwind
                "bradlc.vscode-tailwindcss",
                "dsznajder.es7-react-js-snippets",

                // Supabase
                "Supabase.vscode-supabase-extension",

                // Git / GitHub
                "eamodio.gitlens",
                "GitHub.vscode-pull-request-github",
                "GitHub.vscode-github-actions",

                // Quality-of-life
                "mikestead.dotenv",
                "yzhang.markdown-all-in-one",
                "streetsidesoftware.code-spell-checker",

                // Claude Code VSCode extension
                "anthropic.claude-code"
            ]
        }
    }
}
